---
// A small drawn mark for each project card, hinting at the scene on its page.
const { slug } = Astro.props
const hex = (cx: number, cy: number, r: number) =>
  Array.from({ length: 6 }, (_, k) => { const a = Math.PI / 3 * k - Math.PI / 2; return [cx + r * Math.cos(a), cy + r * Math.sin(a)] })
const ring = (pts: number[][]) => pts.map((p, k) => { const q = pts[(k + 1) % pts.length]; return `M${p[0]} ${p[1]}L${q[0]} ${q[1]}` }).join('')

// deterministic scatter for the cell cloud
let s = 11
const r = () => { s = (s * 16807) % 2147483647; return (s - 1) / 2147483646 }
const blob = (cx: number, cy: number, n: number, sd: number) =>
  Array.from({ length: n }, () => { const a = r() * 6.283, d = Math.sqrt(-2 * Math.log(r() || .01)) * sd; return [cx + Math.cos(a) * d, cy + Math.sin(a) * d * .8] })
const cells = [...blob(36, 44, 26, 9), ...blob(78, 30, 14, 6), ...blob(84, 66, 12, 5.5), ...blob(52, 74, 10, 5)]

const A = hex(44, 52, 15), B = hex(70, 52, 15)
---
<svg class="glyph" viewBox="0 0 120 100" aria-hidden="true">
  {slug === 'sjoint' && (
    <g>
      <path d={ring(A) + ring(B)} class="ink" />
      {[...A, ...B].map(p => <circle cx={p[0]} cy={p[1]} r="2.6" class="atom" />)}
      <path d="M44 52 L70 52 M70 52 L96 30 M44 52 L20 76" class="jt-edge" />
      <circle cx="44" cy="52" r="7" class="jt" /><circle cx="70" cy="52" r="7" class="jt" />
      <circle cx="96" cy="30" r="4" class="jt" /><circle cx="20" cy="76" r="4" class="jt" />
    </g>
  )}
  {slug === 'magnet' && (
    <g>
      <path d={ring(A) + ring(B)} class="ink" />
      <path d={ring(A)} class="cut a" /><path d={ring(B)} class="cut b" />
      <path d="M85 39 L100 26" class="cut c" />
      {[...A, ...B].map(p => <circle cx={p[0]} cy={p[1]} r="2.4" class="atom" />)}
      <circle cx="100" cy="26" r="2.4" class="atom" />
    </g>
  )}
  {slug === 'repurposing' && (
    <g>
      <path d="M60 50 L30 26 M60 50 L26 66 M60 50 L94 24 M60 50 L96 64 M30 26 L26 66 M94 24 L96 64 M60 50 L60 84" class="ink" />
      <path d="M26 66 L60 84" class="ink dashed" />
      <circle cx="60" cy="50" r="7" class="drug" />
      <circle cx="30" cy="26" r="4" class="prot" /><circle cx="26" cy="66" r="4" class="prot" />
      <circle cx="94" cy="24" r="5" class="dis" /><circle cx="96" cy="64" r="5" class="dis" /><circle cx="60" cy="84" r="5" class="dis" />
    </g>
  )}
  {slug === 'aging' && (
    <g>
      {cells.map((p, k) => <circle cx={p[0]} cy={p[1]} r="2" class={k % 7 === 0 && k < 40 ? 'warm' : 'cell'} />)}
    </g>
  )}
</svg>
<style>
  .glyph { width: 100%; height: auto; display: block; }
  .ink { fill: none; stroke: var(--ink); stroke-opacity: .55; stroke-width: 1.3; stroke-linecap: round; }
  .dashed { stroke-dasharray: 3 4; }
  .atom { fill: var(--paper); stroke: var(--atom); stroke-width: 1.2; }
  .jt-edge { stroke: var(--green); stroke-width: 1.6; fill: none; }
  .jt { fill: var(--green-soft); stroke: var(--green); stroke-width: 1.4; }
  .cut { fill: none; stroke-width: 7; stroke-linecap: round; stroke-linejoin: round; opacity: .28; }
  .cut.a { stroke: var(--green); } .cut.b { stroke: var(--blue); } .cut.c { stroke: var(--atom); }
  .drug { fill: var(--green); }
  .prot { fill: var(--paper); stroke: var(--ink); stroke-width: 1.3; }
  .dis { fill: var(--blue); }
  .cell { fill: var(--blue); opacity: .55; }
  .warm { fill: #E39A3B; }
</style>
