---
// The site mark: a six-node ring with one filled node at its centre.
const { size = 28, title = 'Myungjin Lee' } = Astro.props
const R = 13, c = 20
const pts = Array.from({ length: 6 }, (_, k) => {
  const a = (Math.PI / 3) * k - Math.PI / 2
  return [c + R * Math.cos(a), c + R * Math.sin(a)]
})
---
<svg class="mono-mark" width={size} height={size} viewBox="0 0 40 40" role="img" aria-label={title}>
  <g class="edges">
    {pts.map((p, k) => { const q = pts[(k + 1) % 6]; return <line x1={p[0]} y1={p[1]} x2={q[0]} y2={q[1]} /> })}
  </g>
  {pts.map((p, k) => <circle class="n" style={`--k:${k}`} cx={p[0]} cy={p[1]} r="3.1" />)}
  <circle class="core" cx={c} cy={c} r="4.2" />
</svg>
<style>
  .mono-mark { display: block; overflow: visible; }
  .edges line { stroke: var(--green); stroke-width: 1.4; stroke-linecap: round; }
  .n { fill: var(--paper); stroke: var(--green); stroke-width: 1.4; transform-box: fill-box; transform-origin: center; }
  .core { fill: var(--green); transform-box: fill-box; transform-origin: center; }
  :global(a:hover) > .mono-mark .n, .mono-mark:hover .n { animation: wobble .7s cubic-bezier(.3, 1.6, .5, 1) calc(var(--k) * 40ms); }
  :global(a:hover) > .mono-mark .core, .mono-mark:hover .core { animation: pulse .7s ease-out; }
  @keyframes wobble { 40% { transform: scale(1.35); } 100% { transform: scale(1); } }
  @keyframes pulse { 40% { transform: scale(.75); } 100% { transform: scale(1); } }
  @media (prefers-reduced-motion: reduce) { .n, .core { animation: none !important; } }
</style>
