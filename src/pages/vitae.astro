---
import Base from '../layouts/Base.astro'
import { vitae, projectGroups } from '../data/cv'
import { md, u } from '../lib'

const sec = (h: string) => vitae.find(s => s.heading === h) as any
const grp = (h: string) => projectGroups.find(g => g.heading === h)?.items ?? []
// the record only; papers, patents, projects and challenges live on Research, and the grant
// I led is described there too, while here it stays the one-line record a CV is expected to carry
// research in green, study in blue, skills in teal
const TINT: Record<string, string> = { 'Research Interests': 'green', 'Research Experience': 'green', Grants: 'green', Presentations: 'green', Education: 'blue', 'Honors & Awards': 'blue', 'Technical Skills': 'ref', Languages: 'ref' }
const order = [
  { kind: 'vitae', h: 'Research Interests', nav: 'interests' },
  { kind: 'vitae', h: 'Education' },
  { kind: 'vitae', h: 'Research Experience', nav: 'experience' },
  { kind: 'items', h: 'Grants' },
  { kind: 'items', h: 'Presentations', label: 'Poster Presentations', nav: 'posters' },
  { kind: 'vitae', h: 'Honors & Awards', nav: 'honors' },
  { kind: 'vitae', h: 'Technical Skills', nav: 'skills' },
  { kind: 'vitae', h: 'Languages' },
]
---
<Base title="Vitae" description="Curriculum vitae of Myungjin Lee."
  subnav={order.map((o: any) => ({ label: o.nav ?? (o.label ?? o.h).toLowerCase(), href: `#${(o.label ?? o.h).toLowerCase().replace(/[^a-z]+/g, '-')}` }))}>
  <section class="wrap page">
    <div class="head">
      <h1>Vitae</h1>
      <a class="pdf" href={u("assets/MyungjinLee_CV.pdf")} download="MyungjinLee_CV.pdf"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11"/><path d="m7.5 10.5 4.5 4.5 4.5-4.5"/><path d="M5 19.5h14"/></svg>Download CV.pdf</a>
    </div>
    <!-- this page is the one-line record; the work itself is on Research, and nothing here said so -->
    <p class="elsewhere">Papers, patents and research projects are on <a href={u('research/')}>Research</a>.</p>

    {order.map(o => {
      if (o.kind === 'vitae') {
        const s = sec(o.h); if (!s) return null
        return (
          <section class="row" id={(o.label ?? o.h).toLowerCase().replace(/[^a-z]+/g, '-')} style={`--c: var(--${TINT[o.h] ?? 'green'})`}>
            <h2 class="sec">{o.label ?? o.h}</h2>
            <div>
              {s.groups && s.groups.map((g: any) => <p class="t">{g.title}</p><p class="soft">{g.items.join(' · ')}</p>)}
              {s.items && (s.items.every((i: any) => !i.period)
                ? <dl class="kv">{s.items.map((i: any) => <><dt>{i.title}</dt><dd>{i.detail}</dd></>)}</dl>
                : s.items.map((i: any) => (
                    <div class="item">
                      <span class="when mono">{i.period}</span>
                      <div><p class="t">{i.title}</p>{i.detail && <p class="soft" set:html={md(i.detail)} />}</div>
                    </div>
                  )))}
            </div>
          </section>
        )
      }
      const items = grp(o.h)
      return (
        <section class="row" id={(o.label ?? o.h).toLowerCase().replace(/[^a-z]+/g, '-')} style={`--c: var(--${TINT[o.h] ?? 'green'})`}>
          <h2 class="sec">{o.label ?? o.h}</h2>
          <div>
            {items.map((i: any) => (
              <div class="item">
                <span class="when mono">{i.period}</span>
                <div>
                  <p class="t">{i.title}</p>
                  {i.org && <p class="soft">{i.org.replace('Poster · ', '')}</p>}
                  {i.role && <p class="soft">{i.role}</p>}
                </div>
              </div>
            ))}
          </div>
        </section>
      )
    })}
  </section>
</Base>
<style>
  .elsewhere { margin: -8px 0 26px; font-size: calc(14px * var(--fs)); color: var(--muted); }

  .page { padding-block: 36px 24px; }
  .head { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 36px; }
  h1 { font-weight: 600; font-size: calc(clamp(34px, 4.6vw, 46px) * var(--fs)); line-height: 1; letter-spacing: -.02em; margin: 0; }
  .pdf svg { width: 1.15em; height: 1.15em; }
  .pdf { display: inline-flex; align-items: center; gap: 7px; font: calc(12.5px * var(--fs)) var(--mono); white-space: nowrap; border: 1px solid var(--line); border-radius: 4px; padding: 6px 11px; text-decoration: none; background: var(--paper); }
  .row { scroll-margin-top: 20px; margin-bottom: 40px; }
  .row :global(h2.sec) { color: var(--c); }
  .row p { margin: 0 0 8px; }
  .item { display: grid; grid-template-columns: 170px minmax(0, 1fr); gap: 16px; margin-bottom: 14px; }
  @media (max-width: 560px) { .item { grid-template-columns: 1fr; gap: 2px; } }
  .when { font-size: calc(12.5px * var(--fs)); color: var(--muted); line-height: 1.9; white-space: nowrap; }
  .t { font-weight: 500; margin-bottom: 2px !important; }
  .soft { color: var(--soft); font-size: calc(14px * var(--fs)); }
  /* labels (Position:, Thesis:) step back so the content after them leads */
  .soft :global(b) { color: var(--muted); font-weight: 500; }
  .kv { display: grid; grid-template-columns: 190px minmax(0, 1fr); gap: 8px 16px; margin: 0; }
  .kv dt { font-weight: 500; }
  .kv dd { margin: 0; color: var(--soft); font-size: calc(14px * var(--fs)); }
  @media (max-width: 560px) { .kv { grid-template-columns: 1fr; gap: 0; } .kv dd { margin-bottom: 8px; } }
</style>
