  { id: 'descriptors-fingerprints', t: 'Descriptors and fingerprints', d: 'what MACCS, ECFP4 and a PubChem key actually encode' },
  { id: 'gnn', t: 'Graph neural networks', d: 'message passing, and what pooling a graph to one vector throws away' },
