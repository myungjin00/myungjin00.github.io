---
import Base from '../layouts/Base.astro'
import { contact } from '../data/cv'
import { u } from '../lib'
---
<Base title="Contact" description="How to reach Myungjin Lee.">
  <section class="wrap page">
    <h1>Contact</h1>
    <p class="say">{contact.intro}</p>
    <ul class="cards">
      {contact.links.map(l => (
        <li><a href={l.href.startsWith('/') ? u(l.href) : l.href}><span class="k mono">{l.label}</span><span class="v">{l.value}</span><span class="d">{l.desc}</span></a></li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .page { padding-block: 32px 24px; }
  h1 { font-weight: 600; font-size: calc(clamp(34px, 4.6vw, 46px) * var(--fs)); line-height: 1; letter-spacing: -.02em; margin: 0 0 20px; }
  .say { margin: 0 0 16px; color: var(--soft); }
  .cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  @media (max-width: 760px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 420px) { .cards { grid-template-columns: 1fr; } }
  .cards a { display: grid; gap: 3px; padding: 14px 16px; border: 1px solid var(--line); border-radius: 6px; background: var(--plate); text-decoration: none; }
  .cards a:hover { border-color: var(--green); }
  .cards .k { font-size: calc(12px * var(--fs)); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .cards .v { color: var(--ink); font-size: calc(15.5px * var(--fs)); word-break: break-word; }
  .cards .d { font-size: calc(13px * var(--fs)); color: var(--muted); }
</style>
