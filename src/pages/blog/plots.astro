---
import Base from '../../layouts/Base.astro'
import { u } from '../../lib'
import { PLOT_GROUPS } from '../../data/plots'

const subnav = PLOT_GROUPS.map(g => ({ label: g.key, href: `#${g.key}` }))
const total = PLOT_GROUPS.reduce((n, g) => n + g.plots.length, 0)
---
<Base title="Which plot" description={`A catalogue of ${total} plot types — what each one is for, and the line that draws it.`} subnav={subnav}>
  <section class="wrap page" id="plots" data-lang="en">
    <div class="head">
      <div class="head-main">
        <p class="crumb mono"><a href={u('blog/')}>notes</a> / <a href={u('blog/tutorials/')}>guides</a> / plots</p>
        <h1><span data-l="en">Which plot</span><span data-l="ko">어떤 plot을 쓸 것인가</span></h1>
        <p class="lede">
          <span data-l="en">Choosing the plot is most of the work; the code is one line. Under each thumbnail is the call that draws that plot.</span>
          <span data-l="ko">어떤 그림을 그릴지 정하는 것이 작업의 대부분이고, 코드는 한 줄이다. 그림마다 그것을 그리는 호출 한 줄을 아래에 적어 두었다.</span>
        </p>
        <p class="count mono">{total} plots · matplotlib, seaborn and friends</p>
      </div>
      <div class="toggle" role="group" aria-label="Language">
        <button type="button" data-set="en" aria-pressed="true">EN</button>
        <button type="button" data-set="ko" aria-pressed="false">KO</button>
      </div>
    </div>

    {PLOT_GROUPS.map(g => (
      <section class="grp" id={g.key}>
        <h2 class="sec"><span data-l="en">{g.en}</span><span data-l="ko">{g.ko}</span></h2>
        <p class="grp-note"><span data-l="en">{g.noteEn}</span><span data-l="ko">{g.noteKo}</span></p>
        <div class="cards">
          {g.plots.map(p => (
            <figure class="card">
              <div class="thumb"><img src={u(`assets/plots/${p.id}.svg`)} alt={p.name} loading="lazy" /></div>
              <figcaption>
                <p class="name">{p.name}</p>
                <p class="what"><span data-l="en">{p.en}</span><span data-l="ko">{p.ko}</span></p>
                <code>{p.code}</code>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    ))}

    <p class="foot">
      <span data-l="en">The packages themselves are catalogued on the <a href={u('blog/libraries/')}>libraries page</a>.</span>
      <span data-l="ko">패키지 자체는 <a href={u('blog/libraries/')}>라이브러리 페이지</a>에 정리해 두었다.</span>
    </p>
  </section>
</Base>

<script>
  const root = document.getElementById('plots')!
  const apply = (lang: string) => {
    root.dataset.lang = lang
    root.querySelectorAll<HTMLButtonElement>('.toggle button').forEach(b =>
      b.setAttribute('aria-pressed', String(b.dataset.set === lang)))
    try { localStorage.setItem('notes-lang', lang) } catch {}
  }
  root.querySelectorAll<HTMLButtonElement>('.toggle button').forEach(b =>
    b.addEventListener('click', () => apply(b.dataset.set!)))
  let saved: string | null = null
  try { saved = localStorage.getItem('notes-lang') } catch {}
  apply(saved ?? (navigator.language?.startsWith('ko') ? 'ko' : 'en'))
</script>

<style>
  .page { padding-block: 32px 24px; }
  .head { display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; margin-bottom: 44px; }
  .head-main { max-width: 640px; min-width: 0; }
  .crumb { font-size: calc(13px * var(--fs)); color: var(--muted); margin: 0 0 16px; }
  .crumb a { text-decoration: none; color: var(--soft); }
  h1 { font-weight: 600; font-size: calc(clamp(34px, 4.6vw, 46px) * var(--fs)); line-height: 1; letter-spacing: -.02em; margin: 0; }
  .lede { font-family: var(--serif); font-size: calc(18px * var(--fs)); line-height: 1.55; color: var(--soft); margin: 16px 0 0; }
  .count { font-size: calc(12.5px * var(--fs)); color: var(--muted); margin: 12px 0 0; }

  .toggle { display: inline-flex; border: 1px solid var(--line); border-radius: 4px; overflow: hidden; flex: none; }
  .toggle button { font: calc(12px * var(--fs)) var(--mono); color: var(--soft); background: var(--paper); border: 0; padding: 7px 12px; cursor: pointer; white-space: nowrap; line-height: 1.4; }
  .toggle button + button { border-left: 1px solid var(--line); }
  .toggle button[aria-pressed="true"] { background: var(--green); color: var(--paper); }

  [data-l] { display: none; }
  [data-lang="en"] [data-l="en"], [data-lang="ko"] [data-l="ko"] { display: revert; }

  .grp { margin-bottom: 52px; scroll-margin-top: 20px; }
  .grp-note { font-size: calc(14px * var(--fs)); color: var(--soft); margin: 0 0 22px; max-width: 60ch; }

  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(228px, 1fr)); gap: 22px; }
  .card { margin: 0; }
  /* the plate is a true square; the plot sits centred inside it */
  .thumb { aspect-ratio: 1 / 1; border: 1px solid var(--line); border-radius: 8px; background: var(--plate);
           display: grid; place-items: center; padding: 14px; overflow: hidden; }
  .thumb img { width: 100%; height: 100%; object-fit: contain; }
  figcaption { padding-top: 12px; }
  .name { font: 500 calc(13px * var(--fs))/1.3 var(--mono); color: var(--green); margin: 0 0 6px; }
  .what { font-size: calc(14px * var(--fs)); line-height: 1.55; color: var(--soft); margin: 0 0 9px; }
  code { display: block; font-size: calc(12px * var(--fs)); line-height: 1.5; color: var(--muted); background: var(--plate);
         border: 1px solid var(--line); border-radius: 4px; padding: 6px 8px; overflow-wrap: anywhere; }

  .foot { font-size: calc(14px * var(--fs)); color: var(--soft); border-left: 2px solid var(--line); padding-left: 14px; margin: 8px 0 0; }

  @media (max-width: 560px) { .head { flex-direction: column-reverse; align-items: flex-start; gap: 18px; } }
</style>
