---
import Base from '../../layouts/Base.astro'
import { getCollection } from 'astro:content'
import { u, CATEGORIES, mergeTranslations } from '../../lib'
import { GROUPS as LIBS } from '../../data/libraries'
import { PLOT_GROUPS as PLOTS } from '../../data/plots'
import { DB_GROUPS as DBS } from '../../data/databases'
import { ICONS } from '../../data/icons'

const all = (await getCollection('blog', p => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date)

const PREVIEW = 5
// each category previews its most recent few; the category page carries the full shelf
const pubYear = (e: any) => e.lead.data.venueYear ?? e.lead.data.date.getFullYear()
const sections = CATEGORIES.map(c => {
  const entries = mergeTranslations(all.filter(p => p.data.category === c.key))
  // reviews lead with the most recently published paper; the rest lead with the newest note
  const front = c.key === 'review'
    ? [...entries].sort((a, b) => pubYear(b) - pubYear(a) || +b.lead.data.date - +a.lead.data.date)
    : entries
  return { ...c, total: entries.length, entries: front.slice(0, PREVIEW) }
}).filter(s => s.total > 0)
const subnav = [...sections.map(s => ({ label: s.label, href: `#${s.key}` })), { label: 'reference', href: '#reference' }]
const shownIn = (variants: any[], v: any) => (variants.length > 1 ? v.data.lang : 'both')

// Reference-page cards, with counts read from the data rather than typed in twice.
const refs = [
  { href: 'blog/libraries/', name: 'Python libraries', icon: 'libraries',
    en: `${LIBS.reduce((n, g) => n + g.libs.length, 0)} packages by what they are for, and what is inside each.`,
    ko: `용도별 ${LIBS.reduce((n, g) => n + g.libs.length, 0)}개 패키지와 각각 안에 무엇이 들어 있는지.`,
    terms: LIBS.flatMap(g => g.libs.map(l => `${l.name} ${l.parts.join(' ')} ${l.en} ${l.ko}`)) },
  { href: 'blog/plots/', name: 'Which plot', icon: 'plots',
    en: `${PLOTS.reduce((n, g) => n + g.plots.length, 0)} plot types, each with the one line that draws it.`,
    ko: `plot ${PLOTS.reduce((n, g) => n + g.plots.length, 0)}종과 각각을 그리는 한 줄.`,
    terms: PLOTS.flatMap(g => g.plots.map(x => `${x.name} ${x.en} ${x.ko}`)) },
  { href: 'blog/databases/', name: 'Databases', icon: 'databases',
    en: 'What each database is, how big, and whether I have used it.',
    ko: '각 데이터베이스가 무엇이고 얼마나 크고 직접 써 봤는지.',
    terms: DBS.flatMap(g => g.dbs.map(d => `${d.name} ${d.en} ${d.ko}`)) },
  { href: 'blog/shell/', name: 'Shell commands', icon: 'shell',
    en: 'tmux, aliases, ssh, and the GPU checks worth memorising.',
    ko: 'tmux·alias·ssh, 그리고 외워 둘 만한 GPU 확인 명령.',
    terms: ['tmux screen alias ssh scp rsync nvidia-smi htop GPU 단축키 세션'] },
]

// Client-side search index. Headings are included because a heading is usually the name of
// the concept someone is looking for; both languages go into one haystack so a Korean query
// still finds the English page.
---
<Base title="Notes" description="Paper reviews and reference notes on the tools and methods I work with." subnav={subnav}>
  <section class="wrap page" id="notes" data-lang="en">
    <div class="head">
      <div>
        <h1>Notes</h1>
        <p class="lede">
          <span data-l="en">Papers I've read, and references for the tools and methods I work with.</span>
          <span data-l="ko">읽은 논문, 그리고 작업에 쓰는 도구와 방법에 대한 참고 노트.</span>
        </p>
      </div>
      <div class="toggle" role="group" aria-label="Language">
        <button type="button" data-set="en" aria-pressed="true">EN</button>
        <button type="button" data-set="ko" aria-pressed="false">KO</button>
      </div>
    </div>

    <form class="find" role="search" onsubmit="return false">
      <input id="q" type="search" autocomplete="off" spellcheck="false"
             placeholder="Search notes" aria-label="Search notes" />
      <p class="found mono" id="found" hidden></p>
    </form>

    <table class="rows results" id="results" hidden><tbody></tbody></table>

    {sections.map(s => (
      <section class="cat" id={s.key}>
        <div class="cat-head">
          <h2 class="sec"><i class="ico" set:html={ICONS[s.key]} /><span data-l="en">{s.label}</span><span data-l="ko">{s.labelKo}</span></h2>
          <a class="more mono" href={u(`blog/${s.key}s/`)}>
            <span data-l="en">all {s.total} &rarr;</span><span data-l="ko">전체 {s.total}편 &rarr;</span>
          </a>
        </div>
        <table class="rows">
          <tbody>
            {s.entries.map(({ variants }) => variants.map(v => (
              <tr data-l={shownIn(variants, v)}>
                <td>
                  <a href={u(`blog/${v.id}/`)}>{v.data.title}</a>
                  {v.data.venue && <span class="venue mono">{v.data.venue}{v.data.venueYear && <>, {v.data.venueYear}</>}</span>}
                  {v.data.description && <span class="sub">{v.data.description}</span>}
                </td>
                <td class="s">{s.key === 'review' ? (v.data.venueYear ?? v.data.topic) : v.data.topic}</td>
              </tr>
            )))}
          </tbody>
        </table>
      </section>
    ))}

    <section class="cat" id="reference">
      <div class="cat-head">
        <h2 class="sec"><i class="ico" set:html={ICONS.reference} /><span data-l="en">reference</span><span data-l="ko">참고 자료</span></h2>
      </div>
      <p class="ref-lede">
        <span data-l="en">Pages to keep open in another tab, rather than read once.</span>
        <span data-l="ko">한 번 읽고 마는 글이 아니라, 다른 탭에 띄워 두는 쪽.</span>
      </p>
      <div class="refs">
        {refs.map(r => (
          <a class="ref" href={u(r.href)}>
            <span class="ref-name mono"><i class="ico" set:html={ICONS[r.icon]} />{r.name}</span>
            <span class="ref-what"><span data-l="en">{r.en}</span><span data-l="ko">{r.ko}</span></span>
          </a>
        ))}
      </div>
    </section>
  </section>
</Base>

<script>
  const root = document.getElementById('notes')!
  const apply = (lang: string) => {
    root.dataset.lang = lang
    root.querySelectorAll<HTMLButtonElement>('.toggle button').forEach(b =>
      b.setAttribute('aria-pressed', String(b.dataset.set === lang)))
    try { localStorage.setItem('notes-lang', lang) } catch {}
  }
  root.querySelectorAll<HTMLButtonElement>('.toggle button').forEach(b =>
    b.addEventListener('click', () => { apply(b.dataset.set!); run() }))
  let saved: string | null = null
  try { saved = localStorage.getItem('notes-lang') } catch {}
  apply(saved ?? (navigator.language?.startsWith('ko') ? 'ko' : 'en'))

  // --- search ---
  type Row = { l: string; href: string; title: string; venue: string; desc: string; topic: string }
  type Doc = { hay: Record<string, string>; rows: Row[] }
  let docs: Doc[] | null = null
  let loading: Promise<void> | null = null
  const q = document.getElementById('q') as HTMLInputElement
  const load = () => (loading ??= fetch(new URL('search-index.json', location.href).href)
    .then(r => r.json()).then(d => { docs = d }).catch(() => { docs = [] }))
  // warm it before the first keystroke lands
  q.addEventListener('focus', load, { once: true })
  const out = document.getElementById('results') as HTMLTableElement
  const found = document.getElementById('found')!
  const shelves = [...root.querySelectorAll<HTMLElement>('.cat')]
  const esc = (t: string) => t.replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!))

  const run = async () => {
    const terms = q.value.toLowerCase().split(/\s+/).filter(Boolean)
    const searching = terms.length > 0
    if (searching && !docs) { found.hidden = false; found.textContent = 'searching…'; await load() }
    shelves.forEach(el => { el.hidden = searching })
    out.hidden = !searching
    found.hidden = !searching
    if (!searching) return

    const lang = root.dataset.lang === 'ko' ? 'ko' : 'en'
    // match against both languages so a Korean query still finds a note written in English words,
    // but list only the notes that exist in the language the reader picked
    const hits = (docs ?? []).filter(d => {
      const hay = Object.values(d.hay).join(' ')
      return terms.every(t => (hay as string).includes(t))
    }).flatMap(d => d.rows.filter(r => r.l === lang || r.l === 'both'))
    out.querySelector('tbody')!.innerHTML = hits
      .map(r => `
      <tr><td>
        <a href="${r.href}">${esc(r.title)}</a>
        ${r.venue ? `<span class="venue mono">${esc(r.venue)}</span>` : ''}
        ${r.desc ? `<span class="sub">${esc(r.desc)}</span>` : ''}
      </td><td class="s">${esc(r.topic)}</td></tr>`).join('')
    found.textContent = hits.length ? `${hits.length} match${hits.length > 1 ? 'es' : ''}` : 'no match'
  }
  q.addEventListener('input', run)
  // /blog/#q lands with the box focused; the header magnifier is the separate site-wide search
  if (location.hash === '#q') { q.focus(); q.scrollIntoView({ block: 'center' }) }
  // Escape clears, which is what every search box does
  q.addEventListener('keydown', e => { if (e.key === 'Escape') { q.value = ''; run() } })
</script>

<style>
  .page { padding-block: 32px 24px; }
  .head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; margin-bottom: 40px; }
  h1 { font-weight: 600; font-size: calc(clamp(34px, 4.6vw, 46px) * var(--fs)); line-height: 1; letter-spacing: -.02em; margin: 0; }
  .lede { font-family: var(--serif); font-size: calc(18px * var(--fs)); line-height: 1.55; color: var(--soft); margin: 16px 0 0; max-width: 34em; }

  .toggle { display: inline-flex; border: 1px solid var(--line); border-radius: 4px; overflow: hidden; flex: none; }
  .toggle button { font: calc(12px * var(--fs)) var(--mono); color: var(--soft); background: var(--paper); border: 0; padding: 7px 12px; cursor: pointer; white-space: nowrap; line-height: 1.4; }
  .toggle button + button { border-left: 1px solid var(--line); }
  .toggle button[aria-pressed="true"] { background: var(--green); color: var(--paper); }

  /* only the active language is shown; untranslated entries stay visible */
  [data-l] { display: none; }
  [data-lang="en"] [data-l="en"], [data-lang="ko"] [data-l="ko"], [data-l="both"] { display: revert; }
  tr[data-l] { display: none; }
  [data-lang="en"] tr[data-l="en"], [data-lang="ko"] tr[data-l="ko"], tr[data-l="both"] { display: table-row; }

  .find { margin: 0 0 40px; }
  #q { width: 100%; box-sizing: border-box; font: calc(15px * var(--fs))/1.5 var(--sans, inherit); color: inherit;
       background: var(--paper); border: 1px solid var(--line); border-radius: 6px; padding: 11px 14px; }
  #q::placeholder { color: var(--muted); }
  #q:focus { outline: none; border-color: var(--green); }
  #q::-webkit-search-cancel-button { cursor: pointer; }
  .found { font-size: calc(12px * var(--fs)); color: var(--muted); margin: 9px 0 0; }
  .results { margin-bottom: 44px; }
  #reference { scroll-margin-top: calc(var(--head-h, 108px) + 16px); }

  .cat { margin-bottom: 44px; scroll-margin-top: calc(var(--head-h, 108px) + 16px); }
  /* the rule belongs to the whole heading row, so it spans the page as it does on research */
  .cat-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px;
              padding-bottom: 10px; margin-bottom: 16px; border-bottom: 2px solid currentColor; }
  .cat-head > .sec { border-bottom: 0; padding-bottom: 0; margin-bottom: 0; }
  .more { font-size: calc(12.5px * var(--fs)); color: var(--soft); text-decoration: none; border-bottom: 1px solid var(--line); flex: none; }
  .more:hover { color: var(--green); border-bottom-color: currentColor; }
  .quiet { color: var(--muted); font-size: calc(14px * var(--fs)); margin: 0; }
  /* the page is as wide as research; the reading column stays a readable measure */
  td > a, .sub, .venue { max-width: 760px; }
  td a { font-size: calc(15.5px * var(--fs)); }
  .venue { display: block; font-size: calc(12px * var(--fs)); color: var(--muted); margin-top: 2px; }
  .s { color: var(--muted); }

  .ref-lede { font-size: calc(14px * var(--fs)); color: var(--soft); margin: 0 0 18px; }
  .refs { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; }
  .ref { display: block; border: 1px solid var(--line); border-radius: 6px; padding: 15px 17px;
         text-decoration: none; background: var(--paper); transition: border-color .15s, background .15s; }
  .ref:hover { border-color: var(--green); background: var(--plate); }
  .ref-name { display: flex; align-items: center; gap: 7px; font-size: calc(13px * var(--fs)); font-weight: 500; color: var(--green); margin-bottom: 6px; }

  /* icons are a signpost, not decoration: one size, one colour, never on their own */
  .ico { display: inline-flex; flex: none; }
  .ico :global(svg) { width: 1em; height: 1em; }
  /* sized in em so the icon tracks its heading instead of drifting when the heading changes */
  .sec .ico { font-size: 1.05em; color: currentColor; opacity: .85; }
  .ref-name .ico { font-size: 1.35em; }
  .ref-what { display: block; font-size: calc(14px * var(--fs)); line-height: 1.55; color: var(--soft); }
</style>
