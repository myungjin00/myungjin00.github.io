---
import Base from '../../layouts/Base.astro'
import { getCollection } from 'astro:content'
import { u, CATEGORIES, mergeTranslations, topicRank, subRank } from '../../lib'
import { ICONS } from '../../data/icons'

export async function getStaticPaths() {
  const { CATEGORIES } = await import('../../lib')
  return CATEGORIES.map(c => ({ params: { category: c.key + 's' }, props: { cat: c } }))
}
const { cat } = Astro.props

const all = (await getCollection('blog', p => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date)
const allEntries = mergeTranslations(all.filter(p => p.data.category === cat.key))
// reviews run newest-published first; concepts and tutorials run in the order you would read them
const pubRank = (e: any) => -(e.lead.data.venueYear ?? e.lead.data.date.getFullYear())
// newest-published year first; inside one year the parts of a series must stay 1..10,
// which date-descending scrambled, so ties run forwards by date and then by number
const inGroup = cat.key === 'review'
  ? (a: any, b: any) => pubRank(a) - pubRank(b) || +a.lead.data.date - +b.lead.data.date
      || a.lead.id.localeCompare(b.lead.id, undefined, { numeric: true })
  : (a: any, b: any) => +a.lead.data.date - +b.lead.data.date
// a shelf is ranked by its newest paper for reviews, and by reading order otherwise
const shelfKeyOf = (e: any) => e.lead.data.topic ?? ''
const newestIn = (t: string) => Math.min(...allEntries.filter(e => shelfKeyOf(e) === t).map(pubRank))
const shelfRank = cat.key === 'review'
  ? (t: string) => newestIn(t)
  : (t: string) => topicRank(t)
const newestSub = (t: string, sub: string) =>
  Math.min(...allEntries.filter(e => shelfKeyOf(e) === t && (e.lead.data.subtopic ?? '') === sub).map(pubRank))
const subRankIn = cat.key === 'review'
  ? (t: string, sub: string) => newestSub(t, sub)
  : (_t: string, sub: string) => subRank(sub)
const ordered = [...allEntries].sort((a, b) =>
  shelfRank(shelfKeyOf(a)) - shelfRank(shelfKeyOf(b))
  || shelfKeyOf(a).localeCompare(shelfKeyOf(b))
  || subRankIn(shelfKeyOf(a), a.lead.data.subtopic ?? '') - subRankIn(shelfKeyOf(b), b.lead.data.subtopic ?? '')
  || (a.lead.data.subtopic ?? '').localeCompare(b.lead.data.subtopic ?? '')
  || inGroup(a, b))
const entries = ordered

const shelves = [...new Set(entries.map(shelfKeyOf))]
  .sort((a, b) => shelfRank(a) - shelfRank(b) || a.localeCompare(b))
  .map(t => {
    const inTopic = entries.filter(e => shelfKeyOf(e) === t)
    const subs = [...new Set(inTopic.map(e => e.lead.data.subtopic ?? ''))]
      .sort((a, b) => subRankIn(t, a) - subRankIn(t, b) || a.localeCompare(b))
    return {
      label: t,
      // a topic with no subtopics renders as one unnamed run
      groups: subs.map(sub => ({
        label: sub,
        entries: inTopic.filter(e => (e.lead.data.subtopic ?? '') === sub).sort(inGroup),
      })),
    }
  })
const topics = [...new Set(entries.map(e => e.lead.data.topic ?? ''))].filter(Boolean)
const shownIn = (variants: any[], v: any) => (variants.length > 1 ? v.data.lang : 'both')
// topics keep their own casing — 'R' is a language, not a letter
const subnav = shelves.filter(s => s.label)
  .map(s => ({ label: s.label, href: '#' + s.label.toLowerCase().replace(/\s+/g, '-') }))
---
<Base title={cat.label} description={`All ${cat.label} — ${entries.length} notes.`} subnav={subnav}>
  <section class="wrap page" id="notes" data-lang="en">
    <div class="head">
      <div>
        <p class="crumb mono"><a href={u('blog/')}>notes</a> / {cat.label}</p>
        <h1><i class="ico-h" set:html={ICONS[cat.key]} /><span data-l="en">{cat.label}</span><span data-l="ko">{cat.labelKo}</span></h1>
        <p class="count mono">{allEntries.length} notes</p>
      </div>
      <div class="toggle" role="group" aria-label="Language">
        <button type="button" data-set="en" aria-pressed="true">EN</button>
        <button type="button" data-set="ko" aria-pressed="false">KO</button>
      </div>
    </div>

    {cat.key === 'guide' && (
      <p class="aside">
        <span data-l="en">Reference pages, kept separate from the prose: the <a href={u('blog/libraries/')}>Python libraries</a>, <a href={u('blog/plots/')}>which plot to use</a>, and the <a href={u('blog/shell/')}>shell commands</a>, and the <a href={u('blog/databases/')}>databases</a>.</span>
        <span data-l="ko">글과 별도로 둔 참고 페이지: <a href={u('blog/libraries/')}>Python 라이브러리</a>, <a href={u('blog/plots/')}>어떤 plot을 쓸 것인가</a>, <a href={u('blog/shell/')}>셸 명령 모음</a>, <a href={u('blog/databases/')}>데이터베이스</a>.</span>
      </p>
    )}

    {shelves.map(sh => (
      <section class="shelf" id={sh.label.toLowerCase().replace(/\s+/g, '-')}>
        {sh.label && <h2 class="sec">{sh.label}</h2>}
        {sh.groups.map(g => (
          <div class="sub-group">
            {g.label && <p class="sub-label mono">{g.label}</p>}
            <table class="rows">
              <tbody>
                {g.entries.map(({ variants }) => variants.map(v => (
                  <tr data-l={shownIn(variants, v)}>
                    <td>
                      <a href={u(`blog/${v.id}/`)}>{v.data.title}</a>
                      {v.data.venue && <span class="venue mono">{v.data.venue}{v.data.venueYear && <>, {v.data.venueYear}</>}</span>}
                      {v.data.description && <span class="sub">{v.data.description}</span>}
                    </td>
                    <td class="s">{cat.key === 'review' ? (v.data.venueYear ?? '') : v.data.updated}</td>
                  </tr>
                )))}
              </tbody>
            </table>
          </div>
        ))}
      </section>
    ))}

  </section>
</Base>

<script>
  import { shelfPager } from '../../scripts/shelf-pager.js'
  const root = document.getElementById('notes')!
  const apply = (lang: string) => {
    root.dataset.lang = lang
    root.querySelectorAll<HTMLButtonElement>('.toggle button').forEach(b =>
      b.setAttribute('aria-pressed', String(b.dataset.set === lang)))
    try { localStorage.setItem('notes-lang', lang) } catch {}
  }
  root.querySelectorAll<HTMLButtonElement>('.toggle button').forEach(b =>
    b.addEventListener('click', () => apply(b.dataset.set!)))
  let saved: string | null = null
  try { saved = localStorage.getItem('notes-lang') } catch {}
  apply(saved ?? (navigator.language?.startsWith('ko') ? 'ko' : 'en'))
  shelfPager()
</script>

<style>
  .page { padding-block: 32px 24px; }
  .head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; margin-bottom: 36px; }
  .crumb { font-size: calc(13px * var(--fs)); color: var(--muted); margin: 0 0 16px; }
  .crumb a { text-decoration: none; color: var(--soft); }
  h1 { display: flex; align-items: center; gap: 12px; font-weight: 600; font-size: calc(clamp(34px, 4.6vw, 46px) * var(--fs)); line-height: 1; letter-spacing: -.02em; margin: 0; }
  .ico-h { display: inline-flex; flex: none; color: var(--muted); }
  .ico-h :global(svg) { width: .72em; height: .72em; stroke-width: 1.4; }
  .count { font-size: calc(12.5px * var(--fs)); color: var(--muted); margin: 14px 0 0; }

  .toggle { display: inline-flex; border: 1px solid var(--line); border-radius: 4px; overflow: hidden; flex: none; }
  .toggle button { font: calc(12px * var(--fs)) var(--mono); color: var(--soft); background: var(--paper); border: 0; padding: 7px 12px; cursor: pointer; white-space: nowrap; line-height: 1.4; }
  .toggle button + button { border-left: 1px solid var(--line); }
  .toggle button[aria-pressed="true"] { background: var(--green); color: var(--paper); }

  [data-l] { display: none; }
  [data-lang="en"] [data-l="en"], [data-lang="ko"] [data-l="ko"], [data-l="both"] { display: revert; }
  tr[data-l] { display: none; }
  [data-lang="en"] tr[data-l="en"], [data-lang="ko"] tr[data-l="ko"], tr[data-l="both"] { display: table-row; }



  /* clears the sticky contents bar when you jump to a section */
  .shelf { margin-bottom: 44px; scroll-margin-top: calc(var(--head-h, 108px) + 16px); }
  /* the global rule already matches research; only the spacing is tuned here */
  .shelf > .sec { margin-bottom: 20px; }
  .sub-group { margin-bottom: 26px; }
  /* the second level needs to survive a glance, so it gets a rule of its own */
  .sub-label { display: flex; align-items: center; gap: 9px; font-size: calc(12px * var(--fs)); font-weight: 500;
               letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin: 0 0 8px; }
  .sub-label::after { content: ""; flex: 1; height: 1px; background: var(--line); }
  .aside { font-size: calc(14px * var(--fs)); color: var(--soft); border-left: 2px solid var(--line); padding-left: 14px; margin: 0 0 34px; }
  /* same reading measure as the notes index */
  td > a, .sub, .venue { max-width: 760px; }
  td a { font-size: calc(15.5px * var(--fs)); }
  .venue { display: block; font-size: calc(12px * var(--fs)); color: var(--muted); margin-top: 2px; }
  .s { color: var(--muted); }
</style>
