---
import Base from '../layouts/Base.astro'
import { news, projectGroups, profile, aboutClosing } from '../data/cv'
import { projects } from '../data/projects'
import { u, mergeTranslations, tone } from '../lib'
import { getCollection } from 'astro:content'
import { newsIcon } from '../data/icons'

const group = (h: string) => projectGroups.find(g => g.heading === h)?.items ?? []
const papers = [...group('Manuscripts'), ...group('Publications')]

// four things worth opening, each with a page of its own
const selected = projects.map(p => {
  const paper = papers.find(m => m.title.toLowerCase().startsWith(p.title.toLowerCase()))
  return {
    ...p,
    right: paper ? (paper.status === 'Conference paper' ? 'published' : paper.status.toLowerCase()) : p.period,
    done: paper?.status === 'Conference paper',
  }
})

const plain = (s: string) => s.replace(/^[^\p{L}\p{N}]+/u, '')
const allPosts = (await getCollection('blog', p => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date)
const posts = mergeTranslations(allPosts).map(e => e.lead).slice(0, 3)
---
<Base subnav={[
  { label: 'selected', href: '#selected' },
  { label: 'news', href: '#news' },
  { label: 'notes', href: '#notes' },
]}>
  <section class="wrap hero">
    <div class="intro">
      <h1>Myungjin Lee <span class="ko">{profile.nameKo}</span></h1>
      <p class="role">master’s researcher · <a href={profile.lab.href}>PRISM Lab</a>, Dongguk University · Seoul</p>
      <div class="bio">
        <p>I’m a machine learning researcher working at the intersection of AI and drug discovery — a master’s researcher at PRISM Lab, Dongguk University, with Dr. Sangsoo Lim, where I also earned my M.E. in Computer Science and Artificial Intelligence.</p>
        <p>My research is on <span class="hl">graph-based molecular representation learning</span> and <span class="hl">ADMET prediction</span>. A central theme is interpretable molecular prediction: rather than treating these models as black boxes, I build attention-based models that highlight the substructures most relevant to each prediction. I’ve also worked on drug repurposing, and on <span class="hl blue">transcriptomic analysis</span> of cellular senescence and aging-related MASLD.</p>
        <p>Going forward, I want to extend molecular representation learning to drug–target interaction and drug-response prediction, connecting molecular structure to downstream biological effects. I’m looking for opportunities to apply machine learning to drug discovery and molecular data analysis.</p>
      </div>
      <p class="closing">{aboutClosing.before} <a href={u('research/')}>{aboutClosing.hereLabel}</a>{aboutClosing.mid} <a href={u('contact/')}>email</a>{aboutClosing.after}</p>
    </div>
    <figure class="portrait">
      <img src={u('assets/profile_2609.jpg')} alt="Portrait of Myungjin Lee" width="640" height="853">
    </figure>
  </section>

  <section class="wrap block" id="selected">
    <h2 class="sec">selected</h2>
    <table class="rows">
      <tbody>
        {selected.map(p => (
          <tr>
            <td>
              <a href={u(`projects/${p.slug}/`)}>{p.title}</a>
              <span class="sub">{p.line}</span>
            </td>
            <td class="s">{tone(p.right) ? <span class={`pill t-${tone(p.right)}`}>{p.right}</span> : p.right}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="more mono"><a href={u('research/')}>all research →</a></p>
  </section>

  <section class="wrap block two" id="news">
    <div>
      <h2 class="sec">news</h2>
      <ul class="log">
        {news.slice(0, 3).map(n => (
          <li><span class="d mono">{n.date.toLowerCase()}</span><span><span class="ico" set:html={newsIcon(n.text)} />{plain(n.text)}{n.link && <> <a href={n.link.href}>↗</a></>}</span></li>
        ))}
      </ul>
      <p class="more mono"><a href={u('news/')}>all news →</a></p>
    </div>
    <div>
      <h2 class="sec" id="notes">notes</h2>
      {posts.length ? (
        <ul class="log">
          {posts.map(p => <li><span class="d mono">{p.data.category}</span><a href={u(`blog/${p.id}/`)}>{p.data.title}</a></li>)}
        </ul>
      ) : <p class="quiet">Nothing posted yet.</p>}
      <p class="more mono"><a href={u('blog/')}>all notes →</a></p>
    </div>
  </section>

</Base>

<style>
  #selected td a { color: var(--ink); font-weight: 500; text-decoration: none; }
  #selected td a:hover { color: var(--green); }
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 52px; align-items: center; padding-block: 44px 36px; }
  @media (max-width: 900px) { .hero { grid-template-columns: 1fr; gap: 24px; padding-block: 28px 32px; } .portrait { justify-self: start !important; width: 128px !important; } }
  .ko { font-family: var(--serif); font-style: italic; font-weight: 400; font-size: .4em; color: var(--muted); margin-left: .3em; vertical-align: .35em; }
  .closing { margin: 18px 0 0; font-size: calc(14px * var(--fs)); color: var(--soft); }
  h1 { font-weight: 600; font-size: calc(clamp(38px, 5.2vw, 56px) * var(--fs)); line-height: 1; letter-spacing: -.025em; margin: 0; }
  .role { font: calc(12.5px * var(--fs)) var(--mono); color: var(--muted); margin: 14px 0 0; }
  .bio { margin: 22px 0 0; }
  .bio p { margin: 0 0 12px; font-family: var(--serif); font-size: calc(18px * var(--fs)); line-height: 1.6; }
  .bio p:last-child { margin-bottom: 0; }
  .portrait { margin: 0; justify-self: end; width: 196px; aspect-ratio: 3 / 4; border-radius: 6px; overflow: hidden; box-shadow: 0 0 0 1px var(--line), 0 18px 40px -26px rgba(28, 36, 33, .5); }
  .portrait img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .block { padding-block: 24px; }
  .more { margin: 14px 0 0; font-size: calc(12.5px * var(--fs)); }
  .more a { text-decoration: none; }
  .two { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 44px; }
  @media (max-width: 820px) { .two { grid-template-columns: 1fr; gap: 28px; } }
  .log { list-style: none; margin: 0; padding: 0; font-size: calc(14px * var(--fs)); }
  .log li { display: grid; grid-template-columns: 86px minmax(0, 1fr); gap: 12px; padding: 6px 0; color: var(--soft); align-items: baseline; }
  .log .d { font-size: calc(12.5px * var(--fs)); color: var(--muted); white-space: nowrap; }
  .log a { text-decoration: none; }
  .log .ico { display: inline-flex; vertical-align: -2px; margin-right: 7px; color: var(--green); opacity: .85; }
  .log .ico :global(svg) { width: 1em; height: 1em; stroke-width: 1.8; }
  .quiet { color: var(--muted); font-size: calc(14px * var(--fs)); margin: 0; }
</style>
