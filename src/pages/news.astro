---
import Base from '../layouts/Base.astro'
import { news } from '../data/cv'
import { newsIcon } from '../data/icons'

const plain = (s: string) => s.replace(/^[^\p{L}\p{N}]+/u, '')
// newest first, under the year it happened
const years = [...new Set(news.map(n => n.date.slice(-4)))]
---
<Base title="News" description="Talks, degrees, grants and other news from Myungjin Lee."
  subnav={years.map(y => ({ label: y, href: `#y${y}` }))}>
  <section class="wrap page">
    <h1>News</h1>
    {years.map(y => (
      <div class="yr" id={`y${y}`}>
        <h2 class="yr-h">{y}</h2>
        <ul class="log">
          {news.filter(n => n.date.endsWith(y)).map(n => (
            <li><span class="d mono">{n.date.slice(0, 3).toLowerCase()}</span><span><span class="ico" set:html={newsIcon(n.text)} />{plain(n.text)}{n.link && <> <a href={n.link.href}>{n.link.label} ↗</a></>}</span></li>
          ))}
        </ul>
      </div>
    ))}
  </section>
</Base>

<style>
  .page { padding-block: 32px 24px; }
  h1 { font-weight: 600; font-size: calc(clamp(34px, 4.6vw, 46px) * var(--fs)); line-height: 1; letter-spacing: -.02em; margin: 0 0 28px; }
  .yr { scroll-margin-top: 20px; margin-bottom: 26px; }
  .yr-h { font: 500 calc(13px * var(--fs))/1.4 var(--mono); letter-spacing: .07em; color: var(--soft); margin: 0 0 4px; padding-bottom: 6px; border-bottom: 1px solid var(--line); }
  .log { list-style: none; margin: 0; padding: 0; font-size: calc(15.5px * var(--fs)); }
  .log li { display: grid; grid-template-columns: 56px minmax(0, 1fr); gap: 12px; padding: 9px 0; color: var(--ink); align-items: baseline; border-bottom: 1px solid var(--line); }
  .log .d { font-size: calc(12.5px * var(--fs)); color: var(--muted); white-space: nowrap; }
  .log a { font: calc(12.5px * var(--fs)) var(--mono); color: var(--green); text-decoration: none; margin-left: 4px; }
  .log a:hover { text-decoration: underline; }
  .log .ico { display: inline-flex; vertical-align: -2px; margin-right: 8px; color: var(--green); opacity: .85; }
  .log .ico :global(svg) { width: 1em; height: 1em; stroke-width: 1.8; }
</style>
