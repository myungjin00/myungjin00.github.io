---
import '../styles/global.css'
import { u } from '../lib'
import Monogram from '../components/Monogram.astro'
import { GITHUB, LINKEDIN } from '../data/icons'

// Google tag for the GA4 property; '' turns the tag off entirely
const GA_ID = 'G-LX2JQ1VXS4'

// footer marks: the two brand logos as their owners draw them; the CV says what it is in letters
const FOOT = [
  { label: 'GitHub', href: 'https://github.com/myungjin00', svg: GITHUB },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/myungjin00', svg: LINKEDIN },
  { label: 'CV (PDF)', href: u('assets/MyungjinLee_CV.pdf'), svg: '<b class="cv">CV</b>' },
]

const {
  title = 'Myungjin Lee',
  description = 'Myungjin Lee — graph representation learning for molecular property prediction, and transcriptomic analysis of aging and liver disease.',
  katex = false,
  subnav = [],
  parent = undefined,
  lang = 'en',
} = Astro.props
const path = Astro.url.pathname
// One level up. Dropping the last segment is right everywhere except the project pages,
// which belong under /research/ rather than a /projects/ index that does not exist.
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const rel = path.slice(base.length).replace(/^\/|\/$/g, '')
const segs = rel ? rel.split('/') : []
// top-level pages sit one step below home, which the site name already links to, so they get no arrow
const parentHref = parent
  ?? (segs.length <= 1 ? null
      : segs[0] === 'projects' ? u('research/#projects')
      : u(segs.slice(0, -1).join('/') + (segs.length > 1 ? '/' : '')))
// the arrow in the contents bar goes up a level, so it says which level
const parentLabel = parentHref
  ? (parentHref.slice(base.length).split('#')[0].split('/').filter(Boolean).pop() ?? 'home')
  : null
const nav = [
  { label: 'research', href: u('research/'), on: path.endsWith('/research/') || path.includes('/projects/') },
  { label: 'news', href: u('news/'), on: path.endsWith('/news/') },
  { label: 'vitae', href: u('vitae/'), on: path.endsWith('/vitae/') },
  { label: 'blog', href: u('blog/'), on: path.includes('/blog/') },
  { label: 'contact', href: u('contact/'), on: path.endsWith('/contact/') },
]
const pageTitle = title === 'Myungjin Lee' ? title : `${title} · Myungjin Lee`
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{pageTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={new URL(path, Astro.site)}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={new URL(path, Astro.site)}>
  <meta property="og:title" content={title === 'Myungjin Lee' ? 'Myungjin Lee · AI for Drug Discovery' : pageTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content="https://myungjin00.github.io/assets/og.jpg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href={u('favicon.svg')} type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Sans+KR:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&family=Noto+Serif+KR:wght@400&family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400;1,6..72,500&display=swap">
  {katex && <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.css">}
  <script is:inline>
    // runs before the body renders, so the theme never flashes. Three states: a saved light or
    // dark wins, and with nothing saved the page follows the device — which is auto.
    try {
      const saved = localStorage.getItem('theme')
      const dark = saved === 'dark' || (saved !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches)
      if (dark) document.documentElement.dataset.theme = 'dark'
      document.documentElement.dataset.mode = saved === 'dark' || saved === 'light' ? saved : 'auto'
    } catch {}
  </script>
  <script is:inline define:vars={{ ga: GA_ID }}>
    // measurement id is public by design; skipped wherever the site is being served locally —
    // loopback, a LAN address for checking a layout on a phone, or an mDNS name — so that
    // development visits stay out of the numbers
    var local = /^(localhost|\[::1\]|0\.0\.0\.0|127(\.\d{1,3}){3}|10(\.\d{1,3}){3}|192\.168(\.\d{1,3}){2}|172\.(1[6-9]|2\d|3[01])(\.\d{1,3}){2})$|\.local$/
    if (ga && !local.test(location.hostname)) {
      const s = document.createElement('script')
      s.async = true
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga
      document.head.appendChild(s)
      window.dataLayer = window.dataLayer || []
      window.gtag = function () { window.dataLayer.push(arguments) }
      gtag('js', new Date())
      gtag('config', ga)
    }
  </script>
</head>
<body>
  <header class="top">
    <div class="wrap bar">
      <a class="home" href={u('')} aria-label="Myungjin Lee, home"><Monogram size={22} title="" /><span>Myungjin Lee</span></a>
      <div class="bar-right">
        <nav aria-label="Main">
          {nav.map(n => <a href={n.href} aria-current={n.on ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <button class="find-btn" id="theme" type="button" aria-label="Theme: following your device" title="Theme: following your device">
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
               stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path
               d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4"/></svg>
          <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path
               d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
        <button class="find-btn" id="find" type="button" aria-label="Search the site" title="Search the site (/)" data-index={u('search.json')}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
               stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m16.5 16.5 4 4"/></svg>
        </button>
        <div class="fs" role="group" aria-label="Text size">
          <button type="button" data-fs="-" aria-label="Smaller text">A</button>
          <button type="button" data-fs="+" aria-label="Larger text">A</button>
        </div>
      </div>
    </div>
    {(
      <div class="subbar">
        <div class="wrap subbar-in">
          {parentHref && (
            <a class="up" href={parentHref} title={`Up to ${parentLabel}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                   stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path
                   d="M9 14 4 9l5-5"/><path d="M20 20v-7a4 4 0 0 0-4-4H4"/></svg>
              <span>{parentLabel}</span>
            </a>
          )}
          {subnav.length > 0 && <span class="subbar-label mono" aria-hidden="true">contents</span>}
          <nav aria-label="Sections on this page" id="toc">
            {subnav.map((n: any) => <a href={n.href}>{n.label}</a>)}
          </nav>
          <span class="sky-bar mono" id="seoul-bar"></span>
          <label class="season-pick in-bar mono">season <select class="season-select" aria-label="Seasonal background"><option value="auto">auto</option><option value="spring">spring</option><option value="summer">summer</option><option value="autumn">autumn</option><option value="winter">winter</option><option value="off">off</option></select></label>
        </div>
      </div>
    )}
  </header>

  <slot />

  <button class="to-top" id="to-top" type="button" aria-label="Back to top" title="Back to top" hidden>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
  </button>

  <div class="push" aria-hidden="true"></div>
  <footer>
    <div class="wrap foot">
      <a class="mail" href="mailto:leemj637@gmail.com">leemj637 [at] gmail [dot] com</a>
      <span class="out">
        {FOOT.map(f => <a href={f.href} aria-label={f.label} title={f.label} set:html={f.svg} />)}
      </span>
      <span class="copy">© 2026 Myungjin Lee<span class="foot-clock"> · <span id="seoul">Seoul</span></span><label class="season-pick in-foot"> · season <select class="season-select" aria-label="Seasonal background"><option value="auto">auto</option><option value="spring">spring</option><option value="summer">summer</option><option value="autumn">autumn</option><option value="winter">winter</option><option value="off">off</option></select></label></span>
    </div>
  </footer>

  <dialog id="finder" aria-label="Search the site">
    <form method="dialog" class="finder-box">
      <input id="finder-q" type="search" aria-label="Search the site" placeholder="Search the site — papers, projects, news, notes" autocomplete="off" spellcheck="false">
      <ul id="finder-out" role="listbox"></ul>
      <p class="finder-hint mono"><span>↑↓ move · enter open · esc close</span><span class="finder-slash">/ or ⌘K</span></p>
    </form>
  </dialog>

  <script>
    import { initCursor } from '../scripts/cursor.js'
    import { ripple } from '../scripts/ripple.js'
    import { seoulClock } from '../scripts/seoul.js'
    import { seasonFall } from '../scripts/season.js'
    import { decemberTree } from '../scripts/tree.js'
    import { tocSpy } from '../scripts/toc-spy.js'
    import { textSize } from '../scripts/text-size.js'
    initCursor()

    // figures and portraits are not drag or save targets
    for (const ev of ['contextmenu', 'dragstart']) addEventListener(ev, e => {
      const t = e.target as HTMLElement
      if (t && (t.tagName === 'IMG' || t.tagName === 'CANVAS' || t.closest('figure'))) e.preventDefault()
    })
    ripple()
    seoulClock()
    seasonFall()
    decemberTree()
    tocSpy()
    textSize()
    const toTop = document.getElementById('to-top')
    if (toTop) {
      const show = () => {
        // paged listings are short, so 600px meant the button never appeared on them
        const on = scrollY > 320 && document.documentElement.scrollHeight > innerHeight + 240
        toTop.hidden = !on
        requestAnimationFrame(() => toTop.classList.toggle('on', on))
      }
      addEventListener('scroll', show, { passive: true })
      show()
      toTop.addEventListener('click', () => scrollTo({ top: 0, behavior: 'smooth' }))
    }

    const root = document.documentElement
    // auto -> light -> dark -> auto. Without the third stop there is no way back to the device,
    // and one tap used to pin the theme for good.
    const device = matchMedia('(prefers-color-scheme: dark)')
    const LABEL = { auto: 'Theme: following your device', light: 'Theme: light', dark: 'Theme: dark' }
    const paint = (mode) => {
      const dark = mode === 'dark' || (mode === 'auto' && device.matches)
      if (dark) root.dataset.theme = 'dark'; else delete root.dataset.theme
      root.dataset.mode = mode
      const b = document.getElementById('theme')
      if (b) { b.setAttribute('aria-label', LABEL[mode]); b.title = LABEL[mode] }
    }
    const readMode = () => { try { const v = localStorage.getItem('theme'); return v === 'dark' || v === 'light' ? v : 'auto' } catch { return 'auto' } }
    paint(readMode())
    document.getElementById('theme')?.addEventListener('click', () => {
      const next = { auto: 'light', light: 'dark', dark: 'auto' }[readMode()]
      try { next === 'auto' ? localStorage.removeItem('theme') : localStorage.setItem('theme', next) } catch {}
      paint(next)
    })
    // while it is on auto, a device that darkens at its own sunset takes the page with it
    device.addEventListener('change', () => { if (readMode() === 'auto') paint('auto') })

    // site-wide search: titles and summaries of every page; the Notes page keeps its own full-text search
    const finder = document.getElementById('finder') as HTMLDialogElement
    const fq = document.getElementById('finder-q') as HTMLInputElement
    const fout = document.getElementById('finder-out')!
    const findBtn = document.getElementById('find')!
    const KIND: Record<string, string> = { page: 'page', project: 'project', research: 'research', news: 'news', vitae: 'vitae', note: 'note' }
    const RANK = ['page', 'project', 'research', 'news', 'vitae', 'note']
    const GROUP: Record<string, string> = { page: 'Pages', project: 'Projects', research: 'Research', news: 'News', vitae: 'Vitae', note: 'Notes' }
    let index: any[] | null = null, sel = 0, shown: any[] = []
    const esc = (s = '') => s.replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' } as any)[c])
    // wrap every matched word, so a hit shows why it is a hit
    const mark = (text: string, words: string[]) => {
      let out = esc(text)
      for (const w of words) {
        if (w.length < 2 || /^(amp|lt|gt|quot)$/.test(w)) continue
        const re = new RegExp(`(${w.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'ig')
        out = out.replace(re, '\u0001$1\u0002')
      }
      return out.replace(/\u0001/g, '<mark>').replace(/\u0002/g, '</mark>')
    }
    const row = (h: any, i: number, words: string[]) =>
      `<li role="option" aria-selected="${i === sel}" data-i="${i}"><a href="${h.u}">` +
      `<span class="finder-k mono">${KIND[h.k]}</span><span class="finder-t">${mark(h.t, words)}</span>` +
      `${h.d ? `<span class="finder-d">${mark(h.d, words)}</span>` : ''}</a></li>`

    const draw = () => {
      const q = fq.value.trim().toLowerCase()
      const words = q.split(/\s+/).filter(Boolean)
      if (!index) { fout.innerHTML = '<li class="finder-none">Loading\u2026</li>'; return }
      if (!words.length) {
        // never a blank box: the pages and the projects are what most people want
        shown = index.filter(h => h.k === 'page' || h.k === 'project')
        fout.innerHTML = `<li class="finder-group mono">Start here</li>` + shown.map((h, i) => row(h, i, [])).join('')
        return
      }
      const found = index
        .filter(h => words.every(w => h.h.includes(w)))
        .sort((a, b) => RANK.indexOf(a.k) - RANK.indexOf(b.k)
          || (+!a.t.toLowerCase().includes(q) - +!b.t.toLowerCase().includes(q)))
      shown = found
      const total = shown.length
      shown = shown.slice(0, 20)
      sel = Math.min(sel, Math.max(shown.length - 1, 0))
      if (!total) {
        fout.innerHTML = `<li class="finder-none">No match for <b>${esc(q)}</b>. Try a shorter word, or a topic like “attention”, “MASLD”, “benchmark”.</li>`
        return
      }
      // grouped by what kind of thing it is, so the list reads as a map of the site
      let html = '', last = ''
      shown.forEach((h, i) => {
        if (h.k !== last) { html += `<li class="finder-group mono">${GROUP[h.k]}</li>`; last = h.k }
        html += row(h, i, words)
      })
      if (total > shown.length) html += `<li class="finder-group mono">\u2026 and ${total - shown.length} more</li>`
      fout.innerHTML = html
      const cur = fout.querySelector('[aria-selected="true"]') as HTMLElement
      if (cur) cur.scrollIntoView({ block: 'nearest' })
    }
    const openFinder = async () => {
      if (!finder.open) finder.showModal()
      fq.select(); sel = 0
      index ??= await fetch(findBtn.dataset.index!).then(r => r.json()).catch(() => [])
      draw()
    }
    findBtn.addEventListener('click', openFinder)
    addEventListener('keydown', e => {
      const t = e.target as HTMLElement
      const typing = /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName) || t.isContentEditable
      if (!finder.open && !typing && (e.key === '/' || ((e.metaKey || e.ctrlKey) && e.key === 'k'))) { e.preventDefault(); openFinder() }
    })
    fq.addEventListener('input', () => { sel = 0; draw() })
    fq.addEventListener('keydown', e => {
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') { e.preventDefault(); sel = (sel + (e.key === 'ArrowDown' ? 1 : -1) + shown.length) % Math.max(shown.length, 1); draw() }
      if (e.key === 'Enter') { e.preventDefault(); if (shown[sel]) { finder.close(); location.href = shown[sel].u } }
    })
    // the pointer drives the same selection the keyboard does
    fout.addEventListener('pointermove', e => {
      const li = (e.target as HTMLElement).closest('li[data-i]') as HTMLElement
      if (li && +li.dataset.i! !== sel) { sel = +li.dataset.i!; draw() }
    })
    fout.addEventListener('click', e => { if ((e.target as HTMLElement).closest('a')) finder.close() })
    finder.addEventListener('click', e => { if (e.target === finder) finder.close() })
  </script>
</body>
</html>

<style>
  /* the reactive node canvas sits at z-index 0, so page content stacks above it */
  :global(body > header), :global(body > section), :global(body > main), :global(body > article), :global(body > footer) { position: relative; z-index: 1; }

  /* the whole header stays put: the nav and the contents list are both wanted mid-page */
  /* anchors clear the sticky header; measured at runtime so it survives layout changes */
  .top { position: sticky; top: 0; z-index: 10; background: var(--paper);
         border-bottom: 1px solid transparent; }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; height: 66px; font: 14px var(--mono); }
  .home { display: inline-flex; align-items: center; gap: 9px; color: var(--ink); text-decoration: none; white-space: nowrap;
          font: 600 calc(15.5px * var(--fs)) var(--sans); letter-spacing: -.01em; }
  .home:hover { color: var(--green); }
  nav { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; }
  nav::-webkit-scrollbar { display: none; }
  /* where you are reads as a washed-in block, in the top nav and in the contents bar alike */
  nav a { color: var(--soft); text-decoration: none; white-space: nowrap; padding: 4px 10px; border-radius: 5px; }
  nav a:hover { color: var(--green); }
  nav a[aria-current="page"], .subbar a[aria-current="true"] {
    color: var(--green); font-weight: 600; background: color-mix(in srgb, var(--green) 15%, transparent); }

  /* the section list is the only map of a long page, so it stays put and stays legible */
  .subbar { background: var(--paper);
            border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .subbar-in { display: flex; align-items: center; gap: 14px; padding-block: 9px; }
  .subbar nav { flex: 1 1 auto; min-width: 0; }

  /* reading size: scales the article body, not the navigation around it */
  .bar-right { display: flex; align-items: center; gap: 14px; min-width: 0; }
  .find-btn { display: inline-flex; flex: none; color: var(--soft); padding: 3px;
              background: none; border: 0; cursor: pointer; }
  /* one button, two icons: show whichever theme the click would switch to */
  #theme .moon { display: none; }
  :global(:root[data-theme="dark"]) #theme .sun { display: none; }
  :global(:root[data-theme="dark"]) #theme .moon { display: inline; }
  /* on auto the icon still shows the theme in force; a dot says the device is choosing it */
  #theme { position: relative; }
  :global(:root[data-mode="auto"]) #theme::after {
    content: ''; position: absolute; right: 3px; bottom: 3px; width: 4px; height: 4px;
    border-radius: 50%; background: var(--green);
  }
  .find-btn svg { width: 18px; height: 18px; stroke-width: 1.6; }
  .find-btn:hover { color: var(--green); }
  .fs { display: inline-flex; flex: none; border: 1px solid var(--line);
        border-radius: 4px; overflow: hidden; }
  .fs button { font-family: var(--sans); color: var(--soft); background: var(--paper); border: 0;
               cursor: pointer; line-height: 1; padding: 5px 9px; }
  .fs button + button { border-left: 1px solid var(--line); }
  .fs button[data-fs="-"] { font-size: 11px; }
  .fs button[data-fs="+"] { font-size: 15px; }
  .fs button:hover { color: var(--green); }
  .fs button[disabled] { opacity: .35; cursor: default; }
  .up { display: inline-flex; align-items: center; gap: 5px; flex: none; align-self: center;
        color: var(--soft); text-decoration: none; font: 12.5px var(--mono);
        padding: 3px 7px 3px 5px; margin-right: 2px; border: 1px solid var(--line); border-radius: 4px; }
  .up svg { width: 14px; height: 14px; stroke-width: 1.8; }
  .up:hover { color: var(--green); border-color: var(--green); }
  .subbar-label { flex: none; font-size: calc(12px * var(--fs)); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .subbar-label::after { content: ""; display: inline-block; width: 1px; height: 11px;
                         background: var(--line); margin-left: 14px; vertical-align: -1px; }
  .subbar nav { display: flex; flex-wrap: wrap; gap: 4px 4px; font: 13.5px var(--mono); }
  .subbar a { padding: 3px 8px; }
  /* phones: the three pages must all fit, so the name shortens to ~/ and the blocks tighten */
  /* phones: five pages do not fit beside the controls, so the menu takes a row of its own */
  @media (max-width: 640px) {
    .bar { flex-wrap: wrap; height: auto; padding-block: 10px 8px; row-gap: 6px; }
    .bar-right { display: contents; }
    #theme { margin-left: auto; }
    .bar nav[aria-label="Main"] { order: 9; flex-basis: 100%; gap: 2px; margin-inline: -7px; }
    nav a { padding: 4px 7px; }
  }

  @media (max-width: 680px) {
    .subbar-in { gap: 10px; }
    .subbar-label { display: none; }
    .subbar nav { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; gap: 16px; }
    .subbar nav::-webkit-scrollbar { display: none; }
  }

  /* appears once you are far enough down that the sticky header is no longer the quick way back */
  /* just outside the text column, not out at the window edge */
  .to-top { position: fixed; right: max(22px, calc((100vw - var(--measure)) / 2 - 40px)); bottom: 22px; z-index: 20;
            width: 40px; height: 40px; display: grid; place-items: center;
            border: 1px solid var(--green); border-radius: 50%; cursor: pointer;
            /* the page's own colour behind it made it invisible on a light page */
            background: color-mix(in srgb, var(--green) 14%, var(--paper)); color: var(--green);
            box-shadow: 0 6px 20px -12px rgba(0, 0, 0, .55);
            opacity: 0; transform: translateY(6px); transition: opacity .18s, transform .18s, color .15s; }
  .to-top[hidden] { display: none; }
  .to-top.on { opacity: 1; transform: none; }
  .to-top:hover { background: var(--green); color: var(--paper); }
  #finder { width: min(680px, calc(100% - 32px)); margin: 10vh auto auto; padding: 0; border: 1px solid var(--line); border-radius: 8px;
            background: var(--paper); color: var(--ink); box-shadow: 0 24px 60px -24px rgba(0, 0, 0, .45); }
  #finder::backdrop { background: color-mix(in srgb, var(--ink) 28%, transparent); }
  .finder-box { margin: 0; }
  #finder-q { width: 100%; border: 0; border-bottom: 1px solid var(--line); background: transparent; color: var(--ink);
