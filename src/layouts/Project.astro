---
import Base from './Base.astro'
import { u } from '../lib'
import { projects } from '../data/projects'

const { slug, lede, facts = [] } = Astro.props
const p = projects.find(x => x.slug === slug)!
const i = projects.indexOf(p)
const next = projects[(i + 1) % projects.length]
---
<Base title={p.title} description={p.line}>
  <article class="wrap page">
    <h1>{p.title}</h1>
    <p class="lede" set:html={lede} />

    <slot name="plate" />

    <div class="body">
      <div class="main"><slot /></div>
      <aside>
        <dl>
          <dt>role</dt><dd>{p.role}</dd>
          <dt>period</dt><dd>{p.period}</dd>
          {facts.map((f: any) => <><dt>{f.k}</dt><dd set:html={f.v} /></>)}
        </dl>
      </aside>
    </div>

    <nav class="pager mono" aria-label="More projects">
      <a href={u('research/#projects')}>← research</a>
      <a href={u(`projects/${next.slug}/`)}>{next.title} →</a>
    </nav>
  </article>
</Base>

<style>
  .page { padding-block: 32px 24px; }
  h1 { font-weight: 600; font-size: calc(clamp(34px, 4.6vw, 46px) * var(--fs)); line-height: 1; letter-spacing: -.02em; margin: 0; }
  .lede { font-family: var(--serif); font-size: calc(clamp(19px, 2.1vw, 22px) * var(--fs)); line-height: 1.5; max-width: 38em; margin: 16px 0 28px; }

  .body { display: grid; grid-template-columns: minmax(0, 1fr) 230px; gap: 52px; padding-block: 32px 36px; }
  @media (max-width: 860px) { .body { grid-template-columns: 1fr; gap: 26px; } aside { order: -1; } }
  .main { max-width: 680px; font-size: calc(16.5px * var(--fs)); line-height: 1.75; }
  .main :global(h2) { font: 500 calc(12.5px * var(--fs))/1.3 var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--green); margin: 32px 0 10px; }
  .main :global(h2:first-child) { margin-top: 0; }
  .main :global(p) { margin: 0 0 16px; }
  .main :global(ul) { padding-left: 20px; margin: 0 0 16px; }
  .main :global(.paper) { border-left: 3px solid var(--green); padding: 2px 0 2px 16px; margin: 0 0 18px; }
  .main :global(.paper.cell) { border-color: var(--blue); }
  .main :global(details .t) { color: var(--ink); font-weight: 500; margin: 12px 0 0; }
  .main :global(.role) { font: 500 calc(12px * var(--fs))/1 var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--green); background: color-mix(in srgb, var(--green) 12%, transparent); padding: 3px 6px; border-radius: 3px; margin-right: 6px; }
  .main :global(.paper .t) { font-size: calc(15.5px * var(--fs)); font-weight: 500; line-height: 1.45; margin: 0; }
  .main :global(.paper .a), .main :global(.paper .v) { font-size: calc(14px * var(--fs)); color: var(--muted); margin: 2px 0 0; }
  .main :global(details) { border-top: 1px solid var(--line); padding: 10px 0; }
  .main :global(summary) { font: calc(12.5px * var(--fs)) var(--mono); color: var(--soft); cursor: pointer; }
  .main :global(details p) { font-size: calc(14px * var(--fs)); color: var(--soft); margin: 10px 0 0; }

  aside dl { margin: 0; display: grid; gap: 3px; position: sticky; top: 24px; }
  aside dt { font: 500 calc(12px * var(--fs))/1.3 var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); margin-top: 14px; }
  aside dt:first-child { margin-top: 0; }
  aside dd { margin: 0; font-size: calc(14px * var(--fs)); }

  .pager { display: flex; justify-content: space-between; gap: 16px; border-top: 1px solid var(--line); padding-block: 20px; font-size: calc(12.5px * var(--fs)); }
  .pager a { text-decoration: none; color: var(--soft); }
  .pager a:hover { color: var(--green); }
</style>
