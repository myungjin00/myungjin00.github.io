---
import Base from '../../layouts/Base.astro'
import { u } from '../../lib'
import { TERM_GROUPS } from '../../data/glossary'

const subnav = TERM_GROUPS.map(g => ({ label: g.en, href: `#${g.key}` }))
const total = TERM_GROUPS.reduce((n, g) => n + g.terms.length, 0)
const FORM: Record<string, string> = { en: 'English', ko: '한국어', both: '둘 다' }
---
<Base title="Terminology" description={`Which terms this site writes in English and which in Korean, and why — ${total} decisions.`} subnav={subnav}>
  <section class="wrap page" id="gloss" data-lang="en">
    <div class="head">
      <div class="head-main">
        <p class="crumb mono"><a href={u('blog/')}>notes</a> / terminology</p>
        <h1><span data-l="en">Terminology</span><span data-l="ko">용어 기준</span></h1>
        <p class="lede">
          <span data-l="en">Translating a technical term is a decision, not a default. This page records which way each one went, so the notes stay consistent and a reader is never left guessing whether two words mean the same thing.</span>
          <span data-l="ko">전문 용어를 번역할지 말지는 기본값이 아니라 판단이다. 어느 쪽으로 정했는지 여기 적어 둔다. 글마다 흔들리지 않게, 그리고 읽는 사람이 두 단어가 같은 말인지 헷갈리지 않게.</span>
        </p>
        <p class="count mono">{total} terms · {TERM_GROUPS.length} groups</p>
      </div>
      <div class="toggle" role="group" aria-label="Language">
        <button type="button" data-set="en" aria-pressed="true">EN</button>
        <button type="button" data-set="ko" aria-pressed="false">KO</button>
      </div>
    </div>

    {TERM_GROUPS.map(g => (
      <section class="grp" id={g.key}>
        <h2 class="sec"><span data-l="en">{g.en}</span><span data-l="ko">{g.ko}</span></h2>
        <p class="grp-note"><span data-l="en">{g.noteEn}</span><span data-l="ko">{g.noteKo}</span></p>
        <table class="terms">
          <thead>
            <tr>
              <th><span data-l="en">Term</span><span data-l="ko">용어</span></th>
              <th><span data-l="en">Written as</span><span data-l="ko">이렇게 쓴다</span></th>
              <th><span data-l="en">Why</span><span data-l="ko">이유</span></th>
            </tr>
          </thead>
          <tbody>
            {g.terms.map(t => (
              <tr>
                <td class="t-en">{t.en}</td>
                <td class="t-ko"><b>{t.ko}</b><span class="form mono">{FORM[t.form]}</span></td>
                <td class="t-why">{t.why}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    ))}
  </section>
</Base>

<script>
  const root = document.getElementById('gloss')!
  const apply = (lang: string) => {
    root.dataset.lang = lang
    root.querySelectorAll<HTMLButtonElement>('.toggle button').forEach(b =>
      b.setAttribute('aria-pressed', String(b.dataset.set === lang)))
    try { localStorage.setItem('notes-lang', lang) } catch {}
  }
  root.querySelectorAll<HTMLButtonElement>('.toggle button').forEach(b =>
    b.addEventListener('click', () => apply(b.dataset.set!)))
  let saved: string | null = null
  try { saved = localStorage.getItem('notes-lang') } catch {}
  apply(saved ?? (navigator.language?.startsWith('ko') ? 'ko' : 'en'))
</script>

<style>
  .page { padding-block: 32px 24px; max-width: 980px; }
  .head { display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; margin-bottom: 44px; }
  .head-main { max-width: 640px; min-width: 0; }
  .crumb { font-size: 13px; color: var(--muted); margin: 0 0 16px; }
  .crumb a { text-decoration: none; color: var(--soft); }
  h1 { font-weight: 600; font-size: clamp(32px, 4.4vw, 44px); line-height: 1; letter-spacing: -.02em; margin: 0; }
  .lede { font-family: var(--serif); font-size: 18px; line-height: 1.55; color: var(--soft); margin: 16px 0 0; }
  .count { font-size: 12.5px; color: var(--muted); margin: 12px 0 0; }

  .toggle { display: inline-flex; border: 1px solid var(--line); border-radius: 4px; overflow: hidden; flex: none; }
  .toggle button { font: 12px var(--mono); color: var(--soft); background: var(--paper); border: 0; padding: 7px 12px; cursor: pointer; white-space: nowrap; line-height: 1.4; }
  .toggle button + button { border-left: 1px solid var(--line); }
  .toggle button[aria-pressed="true"] { background: var(--green); color: var(--paper); }

  [data-l] { display: none; }
  [data-lang="en"] [data-l="en"], [data-lang="ko"] [data-l="ko"] { display: revert; }

  .grp { margin-bottom: 48px; scroll-margin-top: 20px; }
  .grp-note { font-size: 14.5px; color: var(--soft); margin: 0 0 20px; max-width: 58ch; }

  .terms { width: 100%; border-collapse: collapse; }
  .terms th { text-align: left; font-size: 12px; font-weight: 500; letter-spacing: .04em; text-transform: uppercase;
              color: var(--muted); border-bottom: 1px solid var(--line); padding: 0 12px 8px 0; }
  .terms td { vertical-align: top; padding: 11px 12px 11px 0; border-bottom: 1px solid var(--line); font-size: 14.5px; line-height: 1.5; }
  .terms tr:last-child td { border-bottom: 0; }
  .t-en { font-family: var(--mono); font-size: 13px; color: var(--soft); width: 24%; }
  .t-ko { width: 24%; }
  .t-ko b { font-weight: 600; }
  .form { display: block; font-size: 11.5px; color: var(--muted); margin-top: 3px; }
  .t-why { color: var(--soft); }

  @media (max-width: 640px) {
    .head { flex-direction: column-reverse; align-items: flex-start; gap: 18px; }
    .terms, .terms tbody, .terms tr, .terms td { display: block; width: auto; }
    .terms thead { display: none; }
    .terms tr { border-bottom: 1px solid var(--line); padding: 12px 0; }
    .terms td { border: 0; padding: 2px 0; }
    .t-en { font-size: 12.5px; }
  }
</style>
